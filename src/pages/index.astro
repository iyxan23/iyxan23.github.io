---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Links from '../components/Links.astro';
import Note from '../components/Note.astro';
import Sheet from '../components/Sheet.astro';
import { loadContent } from '../lib/content';

const vm = loadContent();
---

<Base>
  <Hero handle={vm.handle} />
  <main id="stage">
    <canvas id="scene" aria-hidden="true"></canvas>
  </main>
  <Note note={vm.note} />
  <section id="sheet" class="sheet" aria-label="About" inert>
    <div class="sheet-handle" aria-hidden="true"></div>
    <div class="sheet-glow" aria-hidden="true"></div>
    <div class="sheet-scroll" tabindex="0">
      <div class="sheet-inner">
        <Sheet vm={vm} />
      </div>
    </div>
  </section>
  <Links links={vm.links} />
  <button class="cue" type="button" aria-label="Open the page">
    <svg viewBox="0 0 20 20" width="20" height="20" aria-hidden="true" focusable="false">
      <path d="M4.5 12.5 10 7l5.5 5.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </button>
  <noscript>
    <style>.sheet { transform: none !important; position: static; } .sheet-scroll { overflow: visible; } .reveal { opacity: 1 !important; transform: none !important; } #loader { display: none !important; } html { overflow: auto !important; }</style>
  </noscript>
</Base>
