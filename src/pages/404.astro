---
import Base from '../layouts/Base.astro';
import { loadContent } from '../lib/content';

const vm = loadContent();
const title = `404 — ${vm.seo.title}`;
const description = 'The page you requested could not be found.';
---

<Base title={title} description={description} interactive={false} showPersonJsonLd={false}>
  <main class="not-found">
    <p class="eyebrow">404</p>
    <h1 class="name">Page not found.</h1>
    <p class="message">The page you requested doesn't exist or has moved.</p>
    <a class="home" href="/">Back home</a>
    <nav class="links" aria-label="Links">
      {vm.links.map((l, i) => (
        <a href={l.href} target="_blank" rel="noopener noreferrer" style={`--i:${i}`}>{l.label}</a>
      ))}
    </nav>
  </main>
</Base>

<style is:global>
  html,
  body {
    height: auto;
    min-height: 100%;
    overflow: auto;
  }

  .not-found {
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 2rem 1.25rem 3rem;
    gap: 0;
  }

  .not-found .eyebrow {
    margin: 0 0 1rem;
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 0.75rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .not-found .name {
    margin: 0;
    padding: 0 0.1em;
    font-weight: 800;
    font-size: clamp(3rem, 12vw, 7rem);
    line-height: 1.05;
    letter-spacing: -0.045em;
    background: linear-gradient(90deg, #2f6df0 0%, #5a8cf5 30%, #8b7cf0 65%, #9b4dff 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    -webkit-text-fill-color: transparent;
    filter: blur(3px);
    opacity: 0.92;
  }

  @media (prefers-color-scheme: dark) {
    .not-found .name {
      background: linear-gradient(90deg, #5b9bff 0%, #a8dcef 22%, #e4e4f6 55%, #a98af0 85%, #7b5cf0 100%);
      -webkit-background-clip: text;
      background-clip: text;
    }
  }

  .not-found .message {
    margin: 1.25rem 0 0;
    max-width: 28rem;
    font-size: 1rem;
    line-height: 1.5;
    color: var(--muted);
  }

  .not-found .home {
    margin-top: 2rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.8rem 1.25rem;
    border: 1px solid color-mix(in srgb, var(--fg) 14%, transparent);
    border-radius: 999px;
    color: var(--fg);
    text-decoration: none;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    transition: background-color 0.25s ease, border-color 0.25s ease, transform 0.25s ease;
  }

  .not-found .home:hover,
  .not-found .home:focus-visible {
    background: color-mix(in srgb, var(--fg) 6%, transparent);
    border-color: color-mix(in srgb, var(--fg) 24%, transparent);
    outline: none;
  }

  .not-found .links {
    position: static;
    left: auto;
    top: auto;
    transform: none;
    width: min(92vw, 40rem);
    margin-top: 2.5rem;
    pointer-events: auto;
  }

  .not-found .links a {
    opacity: 1;
    transform: none;
    filter: none;
    pointer-events: auto;
    transition-delay: 0s, 0s, 0s, 0s;
  }
</style>
